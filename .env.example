APP_NAME="AI Song Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_song_studio
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@aisongstudio.test"

# -----------------------------------------------------------------
# AI PROVIDER CREDENTIALS — only officially issued, free/paid keys.
# Never commit real keys. Priority order (lowest number tried first)
# is set in database/seeders/AiProviderSeeder.php or the admin panel.
# -----------------------------------------------------------------

# Provider A (priority 1) — e.g. Hugging Face Inference API free tier
AI_PROVIDER_A_KEY=
AI_PROVIDER_A_URL=https://api-inference.huggingface.co
AI_PROVIDER_A_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Provider B (priority 2) — e.g. Replicate free credits
AI_PROVIDER_B_KEY=
AI_PROVIDER_B_URL=https://api.replicate.com/v1
AI_PROVIDER_B_MODEL=

# Provider C (priority 3) — e.g. Stability AI audio free tier
AI_PROVIDER_C_KEY=
AI_PROVIDER_C_URL=https://api.stability.ai/v2beta
AI_PROVIDER_C_MODEL=stable-audio

# Provider D (priority 4) — local/open-source model server (no API key needed)
AI_LOCAL_MODEL_URL=http://127.0.0.1:8800

# Per-user cap independent of provider quotas
AI_USER_DAILY_LIMIT=5
